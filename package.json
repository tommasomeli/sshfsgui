{
  "name": "sshfsgui",
  "version": "1.1.0",
  "description": "A simple SSHFS GUI for macOS",
  "type": "module",
  "author": "tommasomeli",
  "license": "ISC",
  "homepage": "https://github.com/tommasomeli/sshfsgui#readme",
  "bugs": {
    "url": "https://github.com/tommasomeli/sshfsgui/issues"
  },
  "scripts": {
    "sync:meta": "tsx scripts/sync-version.ts",
    "version:sync": "pnpm run sync:meta",
    "dev": "pnpm run sync:meta && tauri dev",
    "dev:frontend": "vite",
    "clean:bundle": "tsx scripts/clean-bundle-artifacts.ts",
    "build": "pnpm run sync:meta && tauri build && pnpm run clean:bundle",
    "build:frontend": "vite build",
    "build:mac": "pnpm run build",
    "build:mac:arm64": "pnpm run sync:meta && tauri build --target aarch64-apple-darwin && pnpm run clean:bundle",
    "build:mac:x64": "pnpm run sync:meta && tauri build --target x86_64-apple-darwin && pnpm run clean:bundle",
    "build:mac:universal": "pnpm run sync:meta && tauri build --target universal-apple-darwin && pnpm run clean:bundle",
    "build:mac:all": "pnpm run build:mac:arm64 && pnpm run build:mac:x64",
    "icons": "tsx scripts/generate-icons.ts",
    "demo:seed": "tsx scripts/demo-data.ts seed",
    "demo:restore": "tsx scripts/demo-data.ts restore",
    "lint": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "typecheck": "npm run lint",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "tauri": "tauri"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tommasomeli/sshfsgui.git"
  },
  "keywords": [
    "sshfs",
    "gui",
    "macos",
    "tauri"
  ],
  "devDependencies": {
    "@tailwindcss/vite": "^4.2.4",
    "@tauri-apps/cli": "^2.11.4",
    "@types/node": "^25.6.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.2.0",
    "tailwindcss": "^4.2.4",
    "tsx": "^4.21.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6.0.3",
    "vite": "^7.3.2",
    "@vitest/coverage-v8": "^3.2.4",
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@tauri-apps/api": "^2.11.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "i18next": "^26.0.8",
    "lucide-react": "^1.11.0",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-i18next": "^17.0.6",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "zustand": "^5.0.12"
  }
}
